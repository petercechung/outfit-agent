{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "outfit-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/thumbs/*", "/feed-images/*"]
  },
  "routes": [{ "pattern": "stylist.cechung.com", "custom_domain": true }],
  // The catalogue, vectors and thumbnails are shared with v1 (outfit.cechung.com). v2 only reads them.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "outfit-assets" }],
  // v2's own database: the full history of every request while we test (src/history.ts). Not shared with v1.
  "d1_databases": [
    {
      "binding": "DB", "database_name": "outfit-agent-db", "database_id": "9ad75a20-c1c9-4f0d-96a2-8b42f7d0985c",
      "migrations_dir": "migrations"
    },
    // v1's database, for the anonymous demand signals 設計師洞察 reads (src/signals.ts). v2 only appends intents.
    { "binding": "SIGNALS_DB", "database_name": "outfit-db", "database_id": "63982b0e-725e-479f-9ddf-51ea0e9bdfda" }
  ],
  // OPENAI_API_KEY is a secret: `wrangler secret put OPENAI_API_KEY` (local dev: .dev.vars).
  "vars": {
    "OPENAI_MODEL": "gpt-5.4-mini",
    "OPENAI_REASONING_EFFORT": "low",
    "OPENAI_EMBED_MODEL": "text-embedding-3-small",
    // Where the critic agent's model fetches product photos from; must be public, so not localhost in dev.
    "IMAGE_ORIGIN": "https://stylist.cechung.com"
  },
  // FashionCLIP's text encoder (encoder/), so sentences land in the same space as the product photos.
  // standard-1 = 1/2 vCPU, 4 GiB: the model needs ~1 GiB; Docker must be running for `wrangler deploy`.
  "containers": [
    { "class_name": "FashionTextEncoder", "image": "./encoder/Dockerfile", "instance_type": "standard-1", "max_instances": 2 }
  ],
  "durable_objects": { "bindings": [{ "name": "TEXT_ENCODER", "class_name": "FashionTextEncoder" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FashionTextEncoder"] }],
  // Every 20 minutes, keep the FashionCLIP container awake (src/index.ts warmEncoder); it sleeps after 30.
  "triggers": { "crons": ["*/20 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
